# Titanic MLP Binary Classification — Configuration

# Project Configuration
LOG_LEVEL=INFO                                                      # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
PROGRESS_BAR=true                                                   # Enable progress bar (tqdm) during training
PRINT_FREQ=5                                                        # Print frequency (every N epochs)
PYTHONPATH=src                                                      # Python module search path

# Data Configuration
TRAIN_DATA_PATH=data/train.csv                                      # Path to the training dataset (CSV)
TEST_DATA_PATH=data/test.csv                                        # Path to the test dataset (CSV)
VAL_SPLIT=0.2                                                       # Validation split ratio (fraction of training data)
RANDOM_SEED=42                                                      # Random seed for reproducibility
DOWNLOAD_DATASET=true                                               # Enable automatic dataset download (true/false)
DATASET_URL=https://raw.githubusercontent.com/ashishpatel26/Titanic-Machine-Learning-from-Disaster/master/input  # Base URL for dataset files (train.csv, test.csv)

# Model Configuration
MODEL_SEED=42                                                       # Random seed for model initialization
INPUT_SIZE=9                                                        # Input feature dimension
HIDDEN_SIZES=64,32,16                                               # Hidden layer sizes (comma-separated)
DROPOUT=0.3                                                         # Dropout probability (0.0 to 1.0)
LEARNING_RATE=0.001                                                 # Learning rate for the optimizer
WEIGHT_DECAY=0.0001                                                 # Weight decay (L2 regularization)
EPOCHS=50                                                           # Number of training epochs
BATCH_SIZE=32                                                       # Batch size for training
GRADIENT_CLIP=1.0                                                   # Gradient clipping threshold

# Device Configuration
DEVICE=auto                                                         # Force device: cpu, cuda, mps, or auto
CUDA_DEVICE=0                                                       # CUDA device ID (when using GPU)
CUDA_PROFILE=false                                                  # Enable CUDA memory profiling
PYTORCH_CUDA_ALLOC_CONF=backend:native,expandable_segments:False    # CUDA allocator config

# PyTorch Configuration
DISTRIBUTED=false                                                   # Enable distributed training (true/false)
WORLD_SIZE=1                                                        # Total number of GPU processes
RANK=0                                                              # Rank of current process (for multi-GPU)
MASTER_ADDR=localhost                                               # Master address for distributed training
MASTER_PORT=29500                                                   # Master port for distributed training
CUDNN_BENCHMARK=false                                               # Enable cuDNN benchmark mode
CUDNN_DETERMINISTIC=false                                           # Enable cuDNN deterministic mode
NUM_WORKERS=0                                                       # Data loader workers (0 = main process)
PIN_MEMORY=true                                                     # Pin memory for CPU->GPU transfer

# Output Configuration
CHECKPOINT_DIR=checkpoints                                          # Directory for model checkpoints
MODEL_PATH=model.pt                                                 # Path to save the final model
SUBMISSION_PATH=submission.csv                                      # Path for the Kaggle submission CSV
